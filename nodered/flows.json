        "height": 0,
        "format": "<div style=\"padding: 10px;\">\n    <a href=\"http://localhost:5001/historial\" target=\"_blank\" style=\"\n       background: #00c8e0;\n       color: #0a0f14;\n       padding: 10px 20px;\n       font-weight: bold;\n       text-decoration: none;\n       border-radius: 4px;\n       font-family: monospace;\n       font-size: 14px;\n     \">\n        📋 Ver Historial de Congeladores\n    </a>\n</div>",
        "storeOutMessages": true,
