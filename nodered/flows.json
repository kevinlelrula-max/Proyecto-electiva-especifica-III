    {
        "id": "2ad0f744ec6d3cce",
        "type": "function",
        "z": "07aca5ed78c7cf03",
        "name": "Congelador A",
        "func": "let data = msg.payload;\n\n// --- Detectar sensor dañado ---\nif (data === null || data.temperatura === undefined ||\n    data.temperatura > 50 || data.temperatura < -80) {\n    msg.sensor_estado = 'FALLA';\n    msg.alerta_tipo   = 'SENSOR_DAÑADO';\n    msg.alerta_msg    = '⛔ Congelador A: sensor sin señal o fuera de rango';\n    msg.congelador    = 'A';\n    return [null, msg];\n}\n\n// --- Evaluar temperatura ---\nif (data.temperatura > -5) {\n    data.estado = 'CRÍTICO';\n} else if (data.temperatura > -18) {\n    data.estado = 'ALERTA';\n} else {\n    data.estado = 'OK';\n}\n\nmsg.temp          = data.temperatura;\nmsg.hum           = data.humedad;\nmsg.esp           = data.especie;\nmsg.tiempo        = data.tiempo_almacenamiento;\nmsg.estado        = data.estado;\nmsg.sensor_estado = 'OK';\nmsg.congelador    = 'A';\n\n// Guardar temp actual en contexto global para regulación\nglobal.set('temp_A', msg.temp);\n\n// Generar alerta si no está en rango normal\nif (data.estado !== 'OK') {\n    msg.alerta_tipo = data.estado === 'CRÍTICO' ? 'TEMP_CRÍTICA' : 'TEMP_ELEVADA';\n    msg.alerta_msg  = (data.estado === 'CRÍTICO' ? '🔴' : '🟠') +\n        ' Congelador A: ' + msg.temp + '°C — ' + data.estado;\n    return [msg, msg];\n}\n\nmsg.alerta_tipo = 'OK';\nmsg.alerta_msg  = '';\nreturn [msg, null];",
