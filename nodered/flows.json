    {
        "id": "ae21285ad46b7d4a",
        "type": "function",
        "z": "07aca5ed78c7cf03",
        "name": "Generador de notificaciones",
        "func": "// Evitar repetir la misma alerta del mismo congelador\nvar cong      = msg.congelador || '?';\nvar tipo      = msg.alerta_tipo;\nvar texto     = msg.alerta_msg;\nvar keyUltima = 'ultima_alerta_' + cong;\nvar ultima    = global.get(keyUltima);\n\n// SOLO registrar si es nueva alerta\nif (ultima !== tipo) {\n    global.set(keyUltima, tipo);\n\n    var now  = new Date();\n    var hora = now.toTimeString().slice(0, 8);\n    var hist = global.get('notificaciones') || [];\n\n    hist.unshift({ hora: hora, tipo: tipo, msg: texto, cong: cong });\n    if (hist.length > 50) hist.pop();\n\n    global.set('notificaciones', hist);\n}\n\n// 🔥 SIEMPRE construir la tabla\nvar hist = global.get('notificaciones') || [];\n\n// Construcción HTML limpia (sin estilos inline)\nvar html = `\n<div class=\"notif-container\">\n    <table class=\"notif-table\">\n        <thead>\n            <tr>\n                <th>Hora</th>\n                <th>Congelador</th>\n                <th>Estado</th>\n                <th>Mensaje</th>\n            </tr>\n        </thead>\n        <tbody>\n`;\n\nhist.forEach(function(n) {\n\n    var badge = 'badge-normal';\n    var textoEstado = 'Normal';\n\n    if (n.tipo === 'TEMP_CRÍTICA') {\n        badge = 'badge-critica';\n        textoEstado = 'Crítica';\n    } \n    else if (n.tipo === 'TEMP_ELEVADA') {\n        badge = 'badge-alerta';\n        textoEstado = 'Alerta';\n    } \n    else if (n.tipo === 'SETPOINT') {\n        badge = 'badge-control';\n        textoEstado = 'Control';\n    } \n    else if (n.tipo === 'SENSOR_DAÑADO') {\n        badge = 'badge-critica';\n        textoEstado = 'Sensor';\n    }\n\n    html += `\n        <tr class=\"notif-row\">\n            <td>${n.hora}</td>\n            <td><strong>${n.cong}</strong></td>\n            <td><span class=\"badge ${badge}\">${textoEstado}</span></td>\n            <td>${n.msg}</td>\n        </tr>\n    `;\n});\n\nhtml += `\n        </tbody>\n    </table>\n</div>\n`;\n\nmsg.payload = html;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
