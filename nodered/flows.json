    {
        "id": "2e73cef8bfa7a6b1",
        "type": "function",
        "z": "07aca5ed78c7cf03",
        "name": "Notif Internet → tabla",
        "func": "// Reconstruir tabla de notificaciones (reutiliza la lógica del generador)\nvar hist = global.get('notificaciones') || [];\nif (hist.length === 0) { return null; }\n\nvar html = '<div class=\"notif-container\"><table class=\"notif-table\">';\nhtml += '<thead><tr><th>Hora</th><th>Congelador</th><th>Estado</th><th>Mensaje</th></tr></thead><tbody>';\n\nhist.forEach(function(n) {\n    var badge = 'badge-normal';\n    var textoEstado = 'Normal';\n    if (n.tipo === 'TEMP_CRÍTICA' || n.tipo === 'INTERNET_FALLA' || n.tipo === 'SENSOR_DAÑADO') { badge = 'badge-critica'; textoEstado = n.tipo === 'INTERNET_FALLA' ? 'Internet' : 'Crítica'; }\n    else if (n.tipo === 'TEMP_ELEVADA') { badge = 'badge-alerta'; textoEstado = 'Alerta'; }\n    else if (n.tipo === 'SETPOINT') { badge = 'badge-control'; textoEstado = 'Control'; }\n    else if (n.tipo === 'INTERNET_OK') { badge = 'badge-normal'; textoEstado = 'Internet'; }\n    html += '<tr class=\"notif-row\"><td>' + n.hora + '</td>';\n    html += '<td><strong>' + n.cong + '</strong></td>';\n    html += '<td><span class=\"badge ' + badge + '\">' + textoEstado + '</span></td>';\n    html += '<td>' + n.msg + '</td></tr>';\n});\nhtml += '</tbody></table></div>';\nmsg.payload = html;\nreturn msg;",
