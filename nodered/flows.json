    {
        "id": "dbedf6479cb474ec",
        "type": "function",
        "z": "07aca5ed78c7cf03",
        "name": "Regulación de temperatura",
        "func": "var setpoint   = msg.payload;\nvar congelador = msg.topic;   // 'A', 'B' o 'C'\nvar temp_actual = global.get('temp_' + congelador) || 0;\n\nglobal.set('setpoint_' + congelador, setpoint);\n\nvar accion;\nif (temp_actual > setpoint + 1) {\n    accion = 'ENFRIAR';\n} else if (temp_actual < setpoint - 1) {\n    accion = 'CALENTAR';\n} else {\n    accion = 'MANTENER';\n}\n\n// Notificar el cambio de setpoint\nvar notifMsg = {\n    alerta_tipo: 'SETPOINT',\n    alerta_msg: '🎛 Congelador ' + congelador + ': setpoint ajustado a ' + setpoint + '°C — acción: ' + accion,\n    congelador: congelador\n};\nnode.send([msg, notifMsg]);\n\n// Publicar comando vía MQTT hacia el simulador.py\nmsg.payload = { congelador: congelador, setpoint: setpoint, accion: accion };\nmsg.topic   = 'pesquera/congelador/' + congelador + '/control';\nreturn null;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
