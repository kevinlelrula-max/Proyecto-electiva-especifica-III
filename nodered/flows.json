        "name": "Internet OK",
        "func": "var prev = global.get('internet_estado') || 'OK';\nglobal.set('internet_estado', 'OK');\n\nmsg.internet = 'OK';\nmsg.internet_msg = '✅ Conexión a internet activa';\nmsg.internet_color = '#166534';\nmsg.internet_bg = '#dcfce7';\n\n// Solo notificar si venía de falla\nif (prev === 'FALLA') {\n    var hist = global.get('notificaciones') || [];\n    var hora = new Date().toTimeString().slice(0,8);\n    hist.unshift({ hora: hora, tipo: 'INTERNET_OK', msg: '✅ Conexión a internet restaurada', cong: 'SYS' });\n    global.set('notificaciones', hist);\n}\n\nreturn msg;",
