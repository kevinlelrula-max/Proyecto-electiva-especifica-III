        "name": "HTML Internet",
        "func": "var estado = msg.internet || global.get('internet_estado') || 'OK';\nvar color  = estado === 'OK' ? '#166534' : '#b91c1c';\nvar bg     = estado === 'OK' ? '#dcfce7' : '#fee2e2';\nvar texto  = estado === 'OK' ? '✅ Conexión activa' : '❌ Sin conexión';\nvar hora   = new Date().toTimeString().slice(0,8);\n\nvar html = '<div style=\"font-family:Segoe UI,sans-serif;padding:10px\">';\nhtml += '<div style=\"display:flex;align-items:center;gap:16px;background:' + bg + ';';\nhtml += 'border-radius:10px;padding:14px 20px\">';\nhtml += '<div style=\"font-size:36px\">' + (estado === 'OK' ? '🌐' : '🔌') + '</div>';\nhtml += '<div>';\nhtml += '<div style=\"font-size:18px;font-weight:700;color:' + color + '\">' + texto + '</div>';\nhtml += '<div style=\"font-size:12px;color:#64748b;margin-top:3px\">Última verificación: ' + hora + ' · Intervalo: cada 30 seg</div>';\nhtml += '</div></div></div>';\n\nmsg.payload = html;\nreturn msg;",
