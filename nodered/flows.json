    {
        "id": "e42b8ac8c70949d1",
        "type": "function",
        "z": "07aca5ed78c7cf03",
        "name": "Estado Cuarto Frío",
        "func": "// Actualizar estado de este congelador en contexto global\nvar cong  = msg.congelador;\nvar temp  = msg.temp;\nvar hum   = msg.hum;\nvar esp   = msg.esp;\nvar est   = msg.estado;\n\nvar estado = global.get('cuarto_estado') || { A: null, B: null, C: null };\nestado[cong] = { temp: temp, hum: hum, esp: esp, estado: est, hora: new Date().toTimeString().slice(0,8) };\nglobal.set('cuarto_estado', estado);\n\n// Determinar estado general del cuarto\nvar critico = false;\nvar alerta  = false;\n['A','B','C'].forEach(function(c) {\n    if (!estado[c]) return;\n    if (estado[c].estado === 'CRÍTICO') critico = true;\n    if (estado[c].estado === 'ALERTA')  alerta  = true;\n});\n\nvar estadoGeneral = critico ? '🔴 CRÍTICO' : alerta ? '🟠 ALERTA' : '🟢 NORMAL';\nvar colorGeneral  = critico ? '#b91c1c'    : alerta  ? '#92400e'  : '#166534';\nvar bgGeneral     = critico ? '#fee2e2'    : alerta   ? '#fef3c7'  : '#dcfce7';\n\n// Construir HTML del panel resumen\nvar html = '<div style=\"font-family:Segoe UI,sans-serif;padding:8px\">';\n\n// Banner de estado general\nhtml += '<div style=\"background:' + bgGeneral + ';color:' + colorGeneral + ';';\nhtml += 'border-radius:10px;padding:12px 20px;margin-bottom:12px;font-size:18px;font-weight:600;text-align:center\">';\nhtml += 'Estado General del Cuarto Frío: ' + estadoGeneral + '</div>';\n\n// Tarjetas de cada congelador\nhtml += '<div style=\"display:flex;gap:12px;flex-wrap:wrap\">';\n['A','B','C'].forEach(function(c) {\n    var d = estado[c];\n    if (!d) {\n        html += '<div style=\"flex:1;min-width:200px;background:#f1f5f9;border-radius:10px;padding:14px\">';\n        html += '<div style=\"font-weight:600;color:#64748b\">Congelador ' + c + '</div>';\n        html += '<div style=\"color:#94a3b8;font-size:13px;margin-top:6px\">Sin datos aún...</div></div>';\n        return;\n    }\n    var bc = d.estado === 'CRÍTICO' ? '#fee2e2' : d.estado === 'ALERTA' ? '#fef3c7' : '#f0fdf4';\n    var tc = d.estado === 'CRÍTICO' ? '#b91c1c' : d.estado === 'ALERTA' ? '#92400e' : '#166534';\n    var em = d.estado === 'CRÍTICO' ? '🔴' : d.estado === 'ALERTA' ? '🟠' : '🟢';\n    html += '<div style=\"flex:1;min-width:200px;background:' + bc + ';border-radius:10px;padding:14px;border:1px solid ' + tc + '33\">';\n    html += '<div style=\"font-weight:700;font-size:15px;color:' + tc + '\">' + em + ' Congelador ' + c + '</div>';\n    html += '<div style=\"margin-top:8px;font-size:13px;color:#334155\">';\n    html += '<div>🌡 <b>' + d.temp + ' °C</b></div>';\n    html += '<div>💧 Humedad: ' + d.hum + '%</div>';\n    html += '<div>🐟 Especie: ' + d.esp + '</div>';\n    html += '<div style=\"color:#94a3b8;font-size:11px;margin-top:4px\">Actualizado: ' + d.hora + '</div>';\n    html += '</div></div>';\n});\nhtml += '</div></div>';\n\nmsg.payload = html;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 900,
        "y": 1450,
