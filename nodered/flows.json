    {
        "id": "d03996ea0cd8d287",
        "type": "function",
        "z": "07aca5ed78c7cf03",
        "name": "Internet FALLA",
        "func": "var prev = global.get('internet_estado') || 'OK';\nglobal.set('internet_estado', 'FALLA');\n\nmsg.internet = 'FALLA';\nmsg.internet_msg = '❌ Sin conexión a internet';\nmsg.internet_color = '#b91c1c';\nmsg.internet_bg = '#fee2e2';\n\n// Solo notificar si es nueva falla\nif (prev !== 'FALLA') {\n    var hist = global.get('notificaciones') || [];\n    var hora = new Date().toTimeString().slice(0,8);\n    hist.unshift({ hora: hora, tipo: 'INTERNET_FALLA', msg: '❌ Pérdida de conexión a internet detectada', cong: 'SYS' });\n    global.set('notificaciones', hist);\n    global.set('ultima_alerta_SYS', 'INTERNET_FALLA');\n}\n\nreturn msg;",
