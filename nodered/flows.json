    {
        "id": "37c62fb713b00856",
        "type": "ui_template",
        "z": "07aca5ed78c7cf03",
        "group": "b9862d2c920d7f15",
        "name": "Tabla de notificaciones",
        "order": 1,
        "width": 12,
        "height": 8,
        "format": "<style>\n    .notif-container {\n        font-family: 'Segoe UI', sans-serif;\n        max-height: 380px;\n        overflow-y: auto;\n        border-radius: 14px;\n        background: #ffffff;\n        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);\n    }\n\n    .notif-table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n\n    /* Header */\n    .notif-table thead {\n        position: sticky;\n        top: 0;\n        background: #1e293b;\n        color: white;\n    }\n\n    .notif-table th {\n        padding: 12px;\n        font-size: 14px;\n        font-weight: 500;\n    }\n\n    /* Celdas */\n    .notif-table td {\n        padding: 12px;\n        font-size: 14px;\n        color: #333;\n    }\n\n    /* Filas */\n    .notif-row {\n        border-bottom: 1px solid #f0f0f0;\n        transition: background 0.2s;\n    }\n\n    .notif-row:hover {\n        background: #f9fafb;\n    }\n\n    /* Badges (colores suaves) */\n    .badge {\n        padding: 4px 10px;\n        border-radius: 999px;\n        font-size: 12px;\n        font-weight: 500;\n    }\n\n    /* Estados suaves */\n    .badge-critica {\n        background: #fee2e2;\n        color: #b91c1c;\n    }\n\n    .badge-alerta {\n        background: #fef3c7;\n        color: #92400e;\n    }\n\n    .badge-control {\n        background: #dbeafe;\n        color: #1e40af;\n    }\n\n    .badge-normal {\n        background: #dcfce7;\n        color: #166534;\n    }\n</style>\n\n<div ng-bind-html=\"msg.payload\"></div>",
